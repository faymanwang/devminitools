{
  "name": "devminitools-tools",
  "version": "1.0.0",
  "description": "DevMiniTools 开发者在线工具箱离线桌面版",
  "private": true,
  "main": "electron/main.js",
  "author": "faymanwang",
  "license": "Apache-2.0",
  "scripts": {
    "start": "electron .",
    "generate:i18n": "node scripts/generate-i18n.mjs",
    "check:site": "node scripts/check-site.mjs",
    "dist": "electron-builder --publish never",
    "dist:win": "electron-builder --win --x64 --publish never",
    "preview": "node scripts/preview.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "prestart": "npm run generate:i18n && npm run check:site",
    "predist": "npm run generate:i18n && npm run check:site && npm test",
    "predist:win": "npm run generate:i18n && npm run check:site && npm test",
    "check:production": "node scripts/check-site.mjs --production"
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "plus.devminitools.tools",
    "productName": "DevMiniTools",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "index.html",
      "*.html",
      "en/**/*.html",
      "css/**/*",
      "js/**/*",
      "img/**/*",
      "vendor/**/*",
      "electron/**/*",
      "robots.txt",
      "sitemap.xml",
      "LICENSE",
      "README.md",
      "guides/**/*.html",
      "THIRD_PARTY_NOTICES.md"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-windows-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-windows-${arch}-portable.${ext}"
    }
  }
}
